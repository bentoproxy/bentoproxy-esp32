# Main task stack. The TLS handshake (mbedTLS plus certificate-bundle
# verification) is stack-hungry and runs on this task, and with LTO the
# compiler can inline large buffers into main()'s frame, which never unwinds.
# 16KB overflowed in practice; the S3 has ~290KB of heap, so be generous.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# WiFi receive buffers. Sized to back the block-ack window below: the window
# cannot usefully exceed the buffers available to hold what it lets in.
# 16 suffices now that frames are copied out at once (see L2_TO_L3_COPY):
# 32 measured identical throughput and only allowed larger bursts.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16

# Enable WiFi
CONFIG_ESP_WIFI_ENABLED=y

# The board's real flash size. IDF assumes 2MB otherwise, which cannot hold
# two 3MB app slots. DIO: this board's flash does not boot in QIO.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Two app slots for over-the-air updates; see partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
# Resolved relative to the IDF build directory, which esp-idf-sys places at
# target/<triple>/<profile>/build/esp-idf-sys-<hash>/out: six levels below
# the repository root, where partitions.csv lives.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"

# A freshly updated image boots on probation. The firmware confirms it only
# after authenticating with the orchestrator; if it crashes, hangs (see the
# watchdog) or reboots first, the bootloader returns to the previous image.
# Needs the bootloader built from this config, not espflash's bundled one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Throughput tuning. The relay is a pure forwarder, so TCP window and WiFi
# buffer sizes set the ceiling; IDF's defaults are sized for small sensor
# payloads and cap a single stream well below link speed.
# Copy each received frame out of the WiFi driver's buffers into lwIP's own.
#
# Without this, unread TCP data stays in the driver's RX buffers until the
# relay reads it, and those buffers are shared with every other incoming
# frame. Several busy streams filled all of them, the board could no longer
# receive the ACKs for its own upload to the orchestrator, the upload stalled,
# the relay stopped reading, and nothing drained: four parallel streams fell
# from 533 KB/s to near zero and the session died. Copying frees the driver
# buffer at once, so unread data can never starve the radio.
CONFIG_LWIP_L2_TO_L3_COPY=y

# Per-connection receive window. Unread data now lives on the heap, so the
# window is a memory budget, not a speed setting:
#   ~150KB free at idle - 26KB WiFi RX bursts - 32KB upload queue - 20KB
#   margin = ~72KB for unread data, / 12 streams (the node's limit) = ~6KB.
# 4 x MSS. At 8.6KB the heap fell to 5KB under 12 streams; at 32KB four
# streams deadlocked. Single-stream speed is lower; aggregate is what counts.
CONFIG_LWIP_TCP_WND_DEFAULT=5760
# Send queue per connection. Only the orchestrator connection sends much, and
# its upload is the relay's critical path. A throughput/memory dial, measured
# under 12 parallel streams once tiT had its own core (see below):
#   24KB: ~502 KB/s aggregate, heap low-water 29KB
#   32KB: ~579 KB/s, heap low-water 22KB   <- chosen
# Before the core split it bought only 4%, because the CPU was the limit.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# Use the hardware crypto blocks for TLS rather than software implementations.
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

# Socket table: the relay's stream limit plus the orchestrator connection and
# DNS. IDF defaults to 10, which caps the node at 8 relayed streams.
CONFIG_LWIP_MAX_SOCKETS=16

# Block-ack (AMPDU) windows: how many frames may be aggregated before an
# acknowledgement. IDF's default of 6 kept the router sending in short bursts
# and waiting; the relay sat idle most of the time while its sockets drained.
# 16 rather than Espressif's 32 keeps buffer memory within the S3's headroom.
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

# CPU at its full 240MHz rather than the 160MHz default. Once the WiFi
# aggregation window stopped starving the relay, writing to the orchestrator
# became the bottleneck, and every relayed byte is masked and TLS-encrypted on
# this core.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Outgoing TLS record size. IDF's 4KB default split every relay frame into two
# separately encrypted records and two socket writes. Frames are now capped by
# the 5760-byte TCP window, so 8KB fits each in one record; 16KB only held
# memory the heap needed.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=8192

# Per-task CPU accounting, for the profile line. Lets the relay tell "busy"
# from "waiting" per core, which its own timers cannot: time inside a write
# includes both encryption and waiting for the socket to drain.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Relieve lwIP's TCP/IP thread (tiT), the measured bottleneck. Every packet and
# every socket send from the relay is serialised through it, and a send blocks
# the caller until tiT has processed it. Under 12 streams core 0 was 88% busy
# running tiT (46%) and the WiFi driver (32%) while core 1 sat 71% idle, and the
# relay spent 9.3s of each 15s blocked inside TLS writes waiting on tiT.
# WiFi keeps core 0; tiT and the relay share core 1.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# lwIP's hot paths from internal RAM rather than flash: no cache misses on
# the busiest code in the system.
CONFIG_LWIP_IRAM_OPTIMIZATION=y
